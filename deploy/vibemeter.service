[Unit]
Description=Vibemeter Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
User=vibemeter
WorkingDirectory=/opt/vibemeter
EnvironmentFile=/etc/vibemeter/env
ExecStart=/opt/vibemeter/venv/bin/python -u bot.py
Restart=always
RestartSec=5
# корректная остановка: aiogram ловит SIGINT
KillSignal=SIGINT
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
